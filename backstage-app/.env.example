# ──────────────────────────────────────────────────────────────
# AAP Compliance Dashboard — Environment Variables
# Copy to .env and fill in values. See docs/standalone-deployment.md
# ──────────────────────────────────────────────────────────────

# ─── AAP Controller Connection (live mode only) ──────────────
# Not needed for mock mode. Set these to connect to a real AAP instance.
AAP_HOST=https://aap.example.com
AAP_AUTH_CLIENT_ID=
AAP_AUTH_CLIENT_SECRET=
AAP_API_TOKEN=

# ─── Backstage Backend Authentication ────────────────────────
# BACKEND_SECRET: Used for Backstage service-to-service auth.
# For local development: leave empty — Backstage auto-generates one.
# For standalone/remote deployment: set a fixed value so frontend
# and backend share the same secret across restarts.
# Generate with: openssl rand -hex 32
BACKEND_SECRET=

# AUTH_SIGNING_KEY: Used for Backstage token verification.
# Same rules as BACKEND_SECRET.
AUTH_SIGNING_KEY=

# ─── Optional — GitHub Integration ───────────────────────────
# Only needed if using GitHub-backed catalog entities.
GITHUB_INTEGRATION_TOKEN=
